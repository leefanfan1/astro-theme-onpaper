{
  "name": "astro-theme-onpaper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "纸上留白 / OnPaper — an original Chinese editorial blog theme for Astro and Cloudflare Pages.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:clean": "npm run clean && astro build",
    "clean": "node scripts/clean.mjs",
    "new": "node scripts/new-post.mjs",
    "preview": "astro preview",
    "shots": "node scripts/screenshots.mjs",
    "og": "node scripts/generate-og.mjs",
    "music": "node scripts/resolve-music.mjs",
    "test:font-email": "npm run build && node tests/font-email-regression.mjs",
    "test:theme-controls": "npm run build && node tests/theme-controls-regression.mjs",
    "test:page-fonts": "npm run build && node tests/page-fonts-regression.mjs",
    "test:performance": "npm run build && node tests/performance-regression.mjs",
    "test:responsiveness": "npm run build && node tests/navigation-responsiveness.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "astro": "^7.4.5",
    "d3-transition": "^3.0.2",
    "katex": "^0.19.1",
    "mermaid": "^12.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "fontkitten": "^1.0.3",
    "fontverter": "^2.0.0",
    "parse5": "^8.1.1",
    "playwright": "^1.59.1",
    "postcss": "^8.5.32",
    "rolldown": "1.3.0",
    "subset-font": "^2.9.0"
  },
  "overrides": {
    "katex": "^0.19.1"
  }
}
