{
  "name": "astro-theme-onpaper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "纸上留白 / OnPaper — 中文个人博客的 Astro 主题：把页边当作页面的一部分。/ An Astro theme for personal blogs: the margin is part of the page.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:clean": "npm run clean && astro build",
    "clean": "node scripts/clean.mjs",
    "new": "node scripts/new-post.mjs",
    "preview": "astro preview",
    "shots": "node scripts/screenshots.mjs",
    "og": "node scripts/generate-og.mjs",
    "music": "node scripts/resolve-music.mjs",
    "test:theme-controls": "npm run build && node tests/theme-controls-regression.mjs",
    "test:font-source": "node tests/hosted-font-security.mjs && node tests/font-text.mjs",
    "test:hosted-fonts": "npm run build && npm run test:font-source && node tests/hosted-fonts-regression.mjs && node tests/search-font-isolation.mjs",
    "test:performance": "npm run build && node tests/performance-regression.mjs",
    "test:responsiveness": "npm run build && node tests/navigation-responsiveness.mjs",
    "test:render": "node tests/markdown-render.mjs",
    "test:i18n": "node tests/i18n.mjs",
    "test:font-gate": "npm run build && node tests/font-gate.mjs",
    "test:shelf-keys": "node tests/shelf-english-keys.mjs",
    "docs:shots": "node scripts/docs-shots.mjs",
    "test:shelf": "node tests/shelf-metadata.mjs && node tests/shelf-document.mjs && node tests/now-document.mjs && node tests/cover-source.mjs && node tests/cover-prune.mjs && node tests/music-cover.mjs && node tests/douban-detail.mjs",
    "covers": "node scripts/fetch-covers.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "~7.4.12",
    "d3-transition": "^3.0.2",
    "katex": "^0.19.1",
    "mermaid": "^12.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "fontkitten": "^1.0.3",
    "fontverter": "^2.0.0",
    "parse5": "^8.1.1",
    "playwright": "^1.59.1",
    "postcss": "^8.5.32",
    "rehype-sanitize": "^6.0.0",
    "rolldown": "1.3.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.4"
  },
  "overrides": {
    "katex": "^0.19.1"
  }
}
