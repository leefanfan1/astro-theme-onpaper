{
  "name": "astro-theme-onpaper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "纸上留白 / OnPaper — an original Chinese editorial blog theme for Astro and Cloudflare Pages.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build:clean": "npm run clean && astro build",
    "clean": "node scripts/clean.mjs",
    "new": "node scripts/new-post.mjs",
    "preview": "astro preview",
    "shots": "node scripts/screenshots.mjs",
    "og": "node scripts/generate-og.mjs",
    "music": "node scripts/resolve-music.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "astro": "^7.4.5",
    "d3-transition": "^3.0.2",
    "katex": "^0.19.1",
    "mermaid": "^12.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "playwright": "^1.59.1"
  },
  "overrides": {
    "katex": "^0.19.1"
  }
}
