---
import { t } from '@/i18n'
import { getCollection, render } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'

const pages = await getCollection('pages')
const about = pages.find(page => page.id === 'about')
const { Content } = about ? await render(about) : { Content: null }
---

<BaseLayout
  title={t('about.title')}
  description={about?.data.description ?? t('about.description')}
>
  <header class="page-head">
    <h1 class="page-title">{about?.data.title ?? t('about.title')}</h1>
  </header>

  <div class="prose">
    {Content && <Content />}
  </div>
</BaseLayout>
