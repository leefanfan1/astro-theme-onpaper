---
import { t } from '@/i18n'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getEntry } from 'astro:content'
import { parseFriends } from '@/utils/friends'

const page = await getEntry('pages', 'friends')
if (!page) throw new Error(t('friends.missing'))
const friends = parseFriends(page.body ?? '')

function displayDomain(url: string) {
  try {
    return new URL(url).hostname
  }
  catch {
    return url
  }
}
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
>
  <header class="page-head">
    <h1 class="page-title">{page.data.title}</h1>
    <p class="page-lead">{t('friends.lead')}</p>
  </header>

  <ul class="friend-list">
    {friends.map(friend => (
      <li>
        <a
          class="friend-link"
          href={friend.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="friend-link__name"><span class="mark-text">{friend.name}</span></span>
          {friend.description && <span class="friend-link__desc">{friend.description}</span>}
          <span class="friend-link__domain">
            {displayDomain(friend.url)}
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M5.5 10.5 10.5 5.5M6.5 5.5h4v4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span class="sr-only">{t('friends.opensNewWindow')}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
