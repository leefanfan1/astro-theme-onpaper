---
import TagIndex from '@/components/TagIndex.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import {
  formatMonthDay,
  getAllPosts,
  getAllTags,
  getPostHref,
  groupByYear,
} from '@/utils/posts'

const posts = await getAllPosts()
const tags = getAllTags(posts)
const years = groupByYear(posts)
---

<BaseLayout title="归档" description="按时间排列的全部文章，以及一份按标签整理的索引。">
  <header class="page-head">
    <h1 class="page-title">归档</h1>
    <p class="page-lead">{years.length > 1 ? `${years.at(-1)![0]} 年至今` : `${years[0]?.[0] ?? ''} 年`}，共 {posts.length} 篇。</p>
  </header>

  <TagIndex {tags} />

  <div class="archive">
    {years.map(([year, yearPosts]) => (
      <section class="year-block" aria-labelledby={`year-${year}`}>
        <div class="year-heading">
          <h2 id={`year-${year}`}>{year}</h2>
          <span>{yearPosts.length} 篇</span>
        </div>
        <ol class="timeline">
          {yearPosts.map(post => (
            <li class="timeline-item">
              <time class="timeline-date" datetime={post.data.published.toISOString()}>
                {formatMonthDay(post.data.published)}
              </time>
              <a class="timeline-title" href={getPostHref(post)}><span class="mark-text">{post.data.title}</span></a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</BaseLayout>
