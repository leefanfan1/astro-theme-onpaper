---
import TagIndex from '@/components/TagIndex.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { t } from '@/i18n'
import {
  formatMonthDay,
  getAllPosts,
  getAllTags,
  getPostHref,
  groupByYear,
} from '@/utils/posts'

const posts = await getAllPosts()
const tags = getAllTags(posts)
const years = groupByYear(posts)
const span = years.length > 1
  ? t('tags.yearsToNow', [years.at(-1)![0]])
  : t('tags.year', [years[0]?.[0] ?? ''])
const total = t('tags.total', [posts.length])
---

<BaseLayout title={t('tags.title')} description={t('tags.description')}>
  <header class="page-head">
    <h1 class="page-title">{t('tags.title')}</h1>
    <p class="page-lead">{span}{total}</p>
  </header>

  <TagIndex {tags} />

  <div class="archive">
    {years.map(([year, yearPosts]) => (
      <section class="year-block" aria-labelledby={`year-${year}`}>
        <div class="year-heading">
          <h2 id={`year-${year}`}>{year}</h2>
          <span>{t('tags.count', [yearPosts.length])}</span>
        </div>
        <ol class="timeline">
          {yearPosts.map(post => (
            <li class="timeline-item">
              <time class="timeline-date" datetime={post.data.published.toISOString()}>
                {formatMonthDay(post.data.published)}
              </time>
              <a class="timeline-title" href={getPostHref(post)}><span class="mark-text">{post.data.title}</span></a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</BaseLayout>
