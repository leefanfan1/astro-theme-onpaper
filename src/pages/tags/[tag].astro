---
import PostList from '@/components/PostList.astro'
import TagIndex from '@/components/TagIndex.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import {
  getAllPosts,
  getAllTags,
  getPostsByTag,
} from '@/utils/posts'

export async function getStaticPaths() {
  const posts = await getAllPosts()
  const tags = getAllTags(posts)
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { tag },
  }))
}

interface Props {
  tag: string
}

const { tag } = Astro.props
const posts = await getAllPosts()
const taggedPosts = getPostsByTag(posts, tag)
const tags = getAllTags(posts)
---

<BaseLayout
  title={`标签：${tag}`}
  description={`标签「${tag}」下的全部文章。`}
>
  <header class="page-head">
    <a class="page-back" href="/tags/">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M19 12H5M11 6l-6 6 6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      归档
    </a>
    <h1 class="page-title">{tag}</h1>
    <p class="page-lead">这个标签下有 {taggedPosts.length} 篇文章。</p>
  </header>

  <section class="post-list-section" aria-label={`标签「${tag}」的文章`}>
    <PostList posts={taggedPosts} />
  </section>

  <div class="tag-more">
    <TagIndex {tags} current={tag} title="其他标签" />
  </div>
</BaseLayout>
