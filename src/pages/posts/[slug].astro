---
import { render } from 'astro:content'
import katexCss from 'katex/dist/katex.min.css?url'
import ArticleEnhancements from '@/components/ArticleEnhancements.astro'
import ReadingProgress from '@/components/ReadingProgress.astro'
import ShareBar from '@/components/ShareBar.astro'
import TableOfContents from '@/components/TableOfContents.astro'
import ViewCount from '@/components/ViewCount.astro'
import { siteConfig } from '@/config'
import BaseLayout from '@/layouts/BaseLayout.astro'
import type { Post } from '@/utils/posts'
import {
  formatDate,
  formatDateLong,
  getAllPosts,
  getPostDescription,
  getTagHref,
  visibleTags,
} from '@/utils/posts'

export async function getStaticPaths() {
  const posts = await getAllPosts()
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }))
}

interface Props {
  post: Post
}

const { post } = Astro.props
const { Content, headings } = await render(post)
// Ignore math-looking text inside fenced/inline code examples.
const mathSource = (post.body ?? '')
  .replace(/```[\s\S]*?```/g, ' ')
  .replace(/~~~[\s\S]*?~~~/g, ' ')
  .replace(/`[^`]*`/g, ' ')
const hasMath = /\$[^$\n]+\$|\$\$[\s\S]+?\$\$/.test(mathSource)
const canonical = new URL(Astro.url.pathname, siteConfig.url).href
const description = getPostDescription(post, 160) || siteConfig.description
const ogImage = new URL('/og.png', siteConfig.url).href

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  'headline': post.data.title,
  'description': description,
  'datePublished': post.data.published.toISOString(),
  'dateModified': (post.data.updated ?? post.data.published).toISOString(),
  'author': {
    '@type': 'Person',
    'name': siteConfig.author,
  },
  'image': ogImage,
  'keywords': visibleTags(post.data.tags).join(', '),
  'mainEntityOfPage': canonical,
}

// Prevent a frontmatter value containing "</script>" from breaking out of
// the JSON-LD element. Escaping "<" is enough for an HTML script context.
const jsonLdHtml = JSON.stringify(jsonLd).replace(/</g, '\\u003c')
---

<BaseLayout
  title={post.data.title}
  description={description}
  article
>
  <Fragment slot="head">
    {hasMath && <link rel="stylesheet" href={katexCss} />}
    <script type="application/ld+json" set:html={jsonLdHtml} />
  </Fragment>

  <ReadingProgress />

  <article class="article">
    <a class="article-home" href="/" data-article-back aria-label="返回上一页">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M19 12H5M11 6l-6 6 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <span>返回</span>
    </a>

    <header class="article-header">
      <h1 class="article-title">{post.data.title}</h1>

      <div class="article-meta">
        <time datetime={post.data.published.toISOString()}>{formatDateLong(post.data.published)}</time>
        {post.data.updated && (
          <>
            <span class="article-meta__dot" aria-hidden="true"></span>
            <span>更新于 {formatDate(post.data.updated)}</span>
          </>
        )}
        <ViewCount slug={post.id} />
      </div>
    </header>

    <TableOfContents {headings} />

    <div class="prose" id="article-content">
      <Content />
    </div>

    <footer class="article-footer">
      {visibleTags(post.data.tags).length > 0 && (
        <ul class="tag-list article-tags" aria-label="文章标签">
          {visibleTags(post.data.tags).map(tag => (
            <li>
              <a class="tag-chip" href={getTagHref(tag)}>{tag}</a>
            </li>
          ))}
        </ul>
      )}

      <ShareBar title={post.data.title} url={canonical} />

      </footer>
  </article>

  <ArticleEnhancements />
</BaseLayout>

<script>
  const LIST_KEY = 'onpaper:list-context'
  const PREVIOUS_KEY = 'onpaper:immediate-previous'
  const RESTORE_KEY = 'onpaper:restore-scroll'
  const MAX_AGE = 1000 * 60 * 60 * 2

  function readSession(key: string) {
    try {
      return JSON.parse(sessionStorage.getItem(key) || 'null')
    }
    catch {
      return null
    }
  }

  function initArticleBack() {
    const button = document.querySelector<HTMLAnchorElement>('[data-article-back]')
    if (!button || button.dataset.bound === 'true') return
    button.dataset.bound = 'true'

    button.addEventListener('click', (event) => {
      const previous = readSession(PREVIOUS_KEY)
      const list = readSession(LIST_KEY)
      const current = location.pathname + location.search
      const fresh = previous?.at && Date.now() - previous.at < MAX_AGE
      const cameFromList = fresh && previous.url && !previous.url.startsWith('/posts/')

      if (cameFromList && history.length > 1) {
        event.preventDefault()
        if (list?.url) sessionStorage.setItem(RESTORE_KEY, JSON.stringify(list))
        history.back()
        return
      }

      if (list?.url && list.url !== current) {
        event.preventDefault()
        sessionStorage.setItem(RESTORE_KEY, JSON.stringify(list))
        location.href = list.url
      }
    })
  }

  document.addEventListener('astro:page-load', initArticleBack)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initArticleBack, { once: true })
  }
  else {
    initArticleBack()
  }
</script>