---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { siteConfig } from '@/config'
import type { ShelfItem } from '@/config'
import musicCache from '@/data/music-cache.json'

// Books, films and music from siteConfig.shelf, hung as a wall of covers.
// An item shows its own cover when it has one (music borrows the cover the
// music cards already cached); otherwise a cover is typeset from the title,
// in one of six inks, so the wall still reads as a wall.
type Kind = 'book' | 'film' | 'music'

const groups: Array<{ id: string, title: string, kind: Kind, items: ShelfItem[] }> = [
  { id: 'books', title: '书', kind: 'book' as const, items: siteConfig.shelf.books },
  { id: 'films', title: '电影', kind: 'film' as const, items: siteConfig.shelf.films },
  { id: 'music', title: '音乐', kind: 'music' as const, items: siteConfig.shelf.music },
].filter(group => group.items.length > 0)

const cache = musicCache as Record<string, { cover?: string }>

function coverOf(item: ShelfItem, kind: Kind) {
  const raw = item.cover || (kind === 'music' && item.url ? cache[item.url]?.cover : '')
  if (!raw) return ''
  if (raw.startsWith('/')) return raw
  try {
    const url = new URL(raw)
    if (url.protocol !== 'https:') return ''
    if (/^p\d+\.music\.126\.net$/.test(url.hostname)) url.searchParams.set('param', '400y400')
    return url.href
  }
  catch {
    return ''
  }
}

// Inks run in order along the wall, offset per shelf, so neighbours never
// share a colour.
const inkOf = (group: number, index: number) => (group * 2 + index) % 6

const verb: Record<Kind, string> = { book: '著', film: '导演', music: '' }
---

<BaseLayout title="书单 · 片单 · 歌单" description="读过、看过、反复听过，愿意推荐给别人的那些。">
  <header class="page-head">
    <h1 class="page-title">书单 · 片单 · 歌单</h1>
    <p class="page-lead">读过、看过、反复听过，愿意推荐给别人的那些。</p>
    {groups.length > 1 && (
      <nav class="shelf-index" aria-label="分类">
        {groups.map(group => (
          <a href={`#shelf-${group.id}`}>{group.title}<span>{group.items.length}</span></a>
        ))}
      </nav>
    )}
  </header>

  {groups.map((group, groupIndex) => (
    <section class="shelf" aria-labelledby={`shelf-${group.id}`} data-kind={group.kind}>
      <h2 class="shelf__title" id={`shelf-${group.id}`}>{group.title}<span>{group.items.length}</span></h2>
      <ul class="shelf-wall" role="list">
        {group.items.map((item, index) => {
          const cover = coverOf(item, group.kind)
          const name = group.kind === 'music' ? item.title : `《${item.title}》`
          const byline = [item.creator && `${item.creator}${verb[group.kind] ? ` ${verb[group.kind]}` : ''}`, item.year].filter(Boolean).join(' · ')
          const body = (
            <>
              <span class:list={['shelf-cover', !cover && `shelf-cover--set ink-${inkOf(groupIndex, index)}`]} aria-hidden="true">
                {cover
                  ? <img src={cover} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                  : (
                      <>
                        {item.year && <span class="shelf-cover__year">{item.year}</span>}
                        <span class="shelf-cover__title">{item.title}</span>
                        <span class="shelf-cover__creator">{item.creator}</span>
                      </>
                    )}
              </span>
              <span class="shelf-card__name"><span class="mark-text">{name}</span></span>
              {byline && <span class="shelf-card__by">{byline}</span>}
              {item.note && <span class="shelf-card__note">{item.note}</span>}
            </>
          )
          return (
            <li>
              {item.url
                ? <a class="shelf-card" href={item.url} target="_blank" rel="noopener noreferrer">{body}<span class="sr-only">（在新窗口打开）</span></a>
                : <div class="shelf-card">{body}</div>}
            </li>
          )
        })}
      </ul>
    </section>
  ))}
</BaseLayout>
