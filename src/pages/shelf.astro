---
import { t } from '@/i18n'
import ShelfWall from '@/components/ShelfWall.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getAllPosts } from '@/utils/posts'
import { loadShelf } from '@/utils/shelf'
import type { ShelfKind } from '@/utils/shelf'

// Books, films and music, each from its own Markdown file under
// src/content/shelf/. Covers come from `npm run covers` (saved in
// public/shelf/) or the music cache; an item with neither gets a cover
// typeset from its title.
const groups: Array<{ id: string, title: string, kind: ShelfKind }> = [
  { id: 'books', title: t('shelf.bookHeading'), kind: 'book' },
  { id: 'films', title: t('shelf.filmHeading'), kind: 'film' },
  { id: 'music', title: t('shelf.musicHeading'), kind: 'music' },
]

const shelf = await loadShelf(await getAllPosts())
const lists = groups
  .map(group => ({ ...group, items: shelf[group.kind] ?? [] }))
  .filter(group => group.items.length > 0)

// Each shelf shows a screenful of covers and folds the rest behind a summary
// that opens without JavaScript. The per-shelf pages page through the list
// instead of folding, so a long shelf never renders every cover at once.
const VISIBLE = 12
---

<BaseLayout title={t('shelf.indexTitle')} description={t('shelf.lead')}>
  <header class="page-head">
    <h1 class="page-title">{t('shelf.indexTitle')}</h1>
    <p class="page-lead">{t('shelf.lead')}</p>
    {lists.length > 1 && (
      <nav class="shelf-index" aria-label={t('shelf.categories')}>
        {lists.map(group => (
          <a href={`#shelf-${group.id}`}>{group.title}<span>{group.items.length}</span></a>
        ))}
      </nav>
    )}
  </header>

  {lists.map((group, groupIndex) => (
    <ShelfWall
      items={group.items}
      kind={group.kind}
      id={`shelf-${group.id}`}
      heading={group.title}
      href={`/shelf/${group.id}/`}
      visible={VISIBLE}
      offset={groupIndex * 2}
    />
  ))}

  <p class="shelf-credit">{t('shelf.credit')}</p>
</BaseLayout>
