---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { t } from '@/i18n'
---

<BaseLayout title="404" noindex>
  <header class="page-head page-head--404">
    <h1 class="page-title">{t('notFound.heading')}</h1>
    <p class="page-lead">{t('notFound.lead')}</p>
    <p class="page-actions">
      <a href="/">{t('notFound.toPosts')}</a>
      <a href="/tags/">{t('notFound.toArchive')}</a>
    </p>
  </header>
</BaseLayout>
