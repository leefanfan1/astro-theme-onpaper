---
import ShelfKindPage from '@/components/ShelfKindPage.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getAllPosts } from '@/utils/posts'
import { loadShelf } from '@/utils/shelf'
import type { ShelfKind } from '@/utils/shelf'

// A shelf's own page: /shelf/books/, /shelf/films/, /shelf/music/. A long
// shelf continues on /shelf/books/page/2/ (src/pages/shelf/[kind]/page/[page].astro).
const KINDS: Record<string, { kind: ShelfKind, title: string, heading: string, lead: string }> = {
  books: { kind: 'book', title: '书单', heading: '书', lead: '读过、想再读，愿意推荐给别人的那些书。' },
  films: { kind: 'film', title: '片单', heading: '电影', lead: '看过、会重看，愿意推荐给别人的那些电影。' },
  music: { kind: 'music', title: '歌单', heading: '音乐', lead: '反复听过的专辑和歌，愿意推荐给别人的那些。' },
}

// Written out rather than read from KINDS: getStaticPaths is bundled on its
// own, and module-level constants are not in scope there.
export function getStaticPaths() {
  return [
    { params: { kind: 'books' } },
    { params: { kind: 'films' } },
    { params: { kind: 'music' } },
  ]
}

const route = Astro.params.kind!
const meta = KINDS[route]
const shelf = await loadShelf(await getAllPosts())
const items = shelf[meta.kind] ?? []
const base = `/shelf/${route}/`
const others = Object.entries(KINDS).filter(([key]) => key !== route)
---

<BaseLayout title={meta.title} description={meta.lead}>
  <header class="page-head">
    <a class="page-back" href="/shelf/">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M19 12H5M11 6l-6 6 6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      书单 · 片单 · 歌单
    </a>
    <h1 class="page-title">{meta.title}</h1>
    <p class="page-lead">{meta.lead}</p>
    {others.length > 0 && (
      <nav class="shelf-index" aria-label="其他清单">
        {others.map(([key, other]) => <a href={`/shelf/${key}/`}>{other.title}</a>)}
      </nav>
    )}
  </header>

  <ShelfKindPage kind={meta.kind} heading={meta.heading} items={items} page={1} base={base} />

  <p class="shelf-credit">书与电影的封面取自豆瓣，只作个人记录之用；封面与简介的权利归豆瓣、出版方和发行方所有。</p>
</BaseLayout>
