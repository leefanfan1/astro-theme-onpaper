---
import { t } from '@/i18n'
import ShelfKindPage from '@/components/ShelfKindPage.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getAllPosts } from '@/utils/posts'
import { loadShelf } from '@/utils/shelf'
import type { ShelfKind } from '@/utils/shelf'
import { SHELF_PER_PAGE } from '@/utils/shelf-covers'

// Page two onwards of a shelf: /shelf/books/page/2/. Page one keeps its short
// address, and `getStaticPaths` returns nothing for it here, so the two routes
// do not compete for the same path.
const KINDS: Record<string, { kind: ShelfKind, title: string, heading: string, lead: string }> = {
  books: { kind: 'book', title: t('shelf.booksTitle'), heading: t('shelf.bookHeading'), lead: t('shelf.booksLead') },
  films: { kind: 'film', title: t('shelf.filmsTitle'), heading: t('shelf.filmHeading'), lead: t('shelf.filmsLead') },
  music: { kind: 'music', title: t('shelf.musicTitle'), heading: t('shelf.musicHeading'), lead: t('shelf.musicLead') },
}

// Written out rather than read from a module constant: getStaticPaths is
// bundled on its own, and module-level constants are not in scope there.
export async function getStaticPaths() {
  const shelf = await loadShelf(await getAllPosts())
  const routes = [
    { route: 'books', kind: 'book' as const },
    { route: 'films', kind: 'film' as const },
    { route: 'music', kind: 'music' as const },
  ]
  const pageSize = SHELF_PER_PAGE
  const paths = []
  for (const { route, kind } of routes) {
    const total = Math.ceil((shelf[kind] ?? []).length / pageSize)
    for (let page = 2; page <= total; page++) {
      paths.push({ params: { kind: route, page: String(page) } })
    }
  }
  return paths
}

const route = Astro.params.kind!
const page = Number(Astro.params.page)
const meta = KINDS[route]
const shelf = await loadShelf(await getAllPosts())
const items = shelf[meta.kind] ?? []
const base = `/shelf/${route}/`
---

<BaseLayout title={t('shelf.pagedTitle', [meta.title, page])} description={meta.lead}>
  <header class="page-head">
    <a class="page-back" href={base}>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M19 12H5M11 6l-6 6 6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      {t('shelf.backToFirst', [meta.title])}
    </a>
    <h1 class="page-title">{meta.title}</h1>
    <p class="page-lead">{t('shelf.pageOf', [page])}</p>
  </header>

  <ShelfKindPage kind={meta.kind} heading={meta.heading} items={items} page={page} base={base} />

  <p class="shelf-credit">书与电影的封面取自豆瓣，只作个人记录之用；封面与简介的权利归豆瓣、出版方和发行方所有。</p>
</BaseLayout>
