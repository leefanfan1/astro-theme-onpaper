---
import { ClientRouter } from 'astro:transitions'
import BackToTop from '@/components/BackToTop.astro'
import Footer from '@/components/Footer.astro'
import FontLoader from '@/components/FontLoader.astro'
import ImageZoom from '@/components/ImageZoom.astro'
import MobileBar from '@/components/MobileBar.astro'
import Search from '@/components/Search.astro'
import SiteRail from '@/components/SiteRail.astro'
import { siteConfig } from '@/config'
import notoMastheadBai from '@fontsource-variable/noto-serif-sc/files/noto-serif-sc-116-wght-normal.woff2?url'
import notoMastheadYu from '@fontsource-variable/noto-serif-sc/files/noto-serif-sc-114-wght-normal.woff2?url'
import '@fontsource-variable/noto-serif-sc'
import '@/styles/fonts.css'
import '@/styles/base.css'
import '@/styles/prose.css'
import '@/styles/extensions.css'

interface Props {
  title?: string
  description?: string
  image?: string
  imageWidth?: number
  imageHeight?: number
  article?: boolean
  noindex?: boolean
}

const {
  title,
  description = siteConfig.description,
  image = '/og.png',
  imageWidth = 1200,
  imageHeight = 630,
  article = false,
  noindex = false,
} = Astro.props

const pageTitle = title ? `${title} · ${siteConfig.title}` : `${siteConfig.title} — ${siteConfig.subtitle}`
const canonical = new URL(Astro.url.pathname, siteConfig.url).href
const ogImage = new URL(image, siteConfig.url).href
const ogImageType = image.endsWith('.png')
  ? 'image/png'
  : image.endsWith('.webp')
    ? 'image/webp'
    : image.endsWith('.jpg') || image.endsWith('.jpeg')
      ? 'image/jpeg'
      : undefined
const ogLocale = siteConfig.lang.replace('-', '_')
const { light, dark } = siteConfig.theme
const gaId = siteConfig.analytics.googleAnalyticsId.trim()
const isHomePage = Astro.url.pathname === '/' || Astro.url.pathname.startsWith('/page/')

const tokenNames: Record<keyof typeof light, string> = {
  paper: '--paper',
  paperRaised: '--paper-raised',
  surface: '--surface',
  surfaceAlt: '--surface-alt',
  ink: '--ink',
  inkSoft: '--ink-soft',
  inkFaint: '--ink-faint',
  line: '--line',
  accent: '--accent',
  accentStrong: '--accent-strong',
  accentSoft: '--accent-soft',
  peach: '--peach',
  moss: '--moss',
  selection: '--selection',
}

function tokensToCss(tokens: typeof light) {
  return (Object.keys(tokenNames) as Array<keyof typeof light>)
    .map(key => `${tokenNames[key]}:${tokens[key]};`)
    .join('')
}

const themeCSS = `
:root{${tokensToCss(light)}--font-display:${siteConfig.fonts.display};--font-body:${siteConfig.fonts.body};--font-mono:${siteConfig.fonts.mono};color-scheme:light}
html[data-theme="dark"]{${tokensToCss(dark)}color-scheme:dark}
@media (prefers-color-scheme: dark){html:not([data-theme="light"]){${tokensToCss(dark)}color-scheme:dark}}
`
---

<!doctype html>
<html
  lang={siteConfig.lang}
  data-default-mode={siteConfig.theme.defaultMode}
  data-theme={siteConfig.theme.defaultMode === 'auto' ? undefined : siteConfig.theme.defaultMode}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <FontLoader />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />
    <meta name="theme-color" content={siteConfig.theme.defaultMode === 'dark' ? dark.paper : light.paper} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.title} RSS`} href="/rss.xml" />
    <link rel="preload" href={notoMastheadYu} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={notoMastheadBai} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={pageTitle} />
    {ogImageType && <meta property="og:image:type" content={ogImageType} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={pageTitle} />
    <slot name="head" />

    <script is:inline define:vars={{
      defaultMode: siteConfig.theme.defaultMode,
      lightPaper: light.paper,
      darkPaper: dark.paper,
    }}>
      (function () {
        document.documentElement.classList.add('js')
        var stored = null
        try { stored = localStorage.getItem('onpaper-theme') } catch (error) {}
        var system = window.matchMedia('(prefers-color-scheme: dark)').matches
        var mode = (stored === 'light' || stored === 'dark') ? stored : defaultMode
        var isDark = mode === 'dark' || (mode === 'auto' && system)
        document.documentElement.dataset.theme = isDark ? 'dark' : 'light'
        document.documentElement.style.colorScheme = isDark ? 'dark' : 'light'
        var meta = document.querySelector('meta[name="theme-color"]')
        if (meta) meta.setAttribute('content', isDark ? darkPaper : lightPaper)

        // ClientRouter swaps the html attributes; re-apply the stored theme to
        // the incoming document before the swap so navigation does not flash.
        document.addEventListener('astro:before-swap', function (event) {
          try {
            if (!event.newDocument) return
            var nextStored = localStorage.getItem('onpaper-theme')
            var nextSystem = window.matchMedia('(prefers-color-scheme: dark)').matches
            var nextMode = (nextStored === 'light' || nextStored === 'dark') ? nextStored : defaultMode
            var nextDark = nextMode === 'dark' || (nextMode === 'auto' && nextSystem)
            event.newDocument.documentElement.classList.add('js')
            event.newDocument.documentElement.dataset.theme = nextDark ? 'dark' : 'light'
            event.newDocument.documentElement.style.colorScheme = nextDark ? 'dark' : 'light'
            var nextMeta = event.newDocument.querySelector('meta[name="theme-color"]')
            if (nextMeta) nextMeta.setAttribute('content', nextDark ? darkPaper : lightPaper)
          }
          catch (error) {}
        })
      })()
    </script>

    <style is:inline set:html={themeCSS}></style>

    {gaId && import.meta.env.PROD && (
      <>
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaId)}`}
        ></script>
        <script is:inline define:vars={{ gaId }}>
          (function () {
            window.dataLayer = window.dataLayer || []
            function gtag() { window.dataLayer.push(arguments) }
            window.gtag = gtag
            gtag('js', new Date())
            // Astro's ClientRouter changes the URL without a full reload, so
            // send page_view explicitly on every astro:page-load instead of
            // relying on gtag's initial automatic page view.
            gtag('config', gaId, { send_page_view: false })
            var lastUrl = ''
            function trackPageView() {
              if (location.href === lastUrl) return
              lastUrl = location.href
              gtag('event', 'page_view', {
                page_location: location.href,
                page_title: document.title,
              })
            }
            document.addEventListener('astro:page-load', trackPageView)
            trackPageView()
          })()
        </script>
      </>
    )}

    <ClientRouter fallback="swap" />
  </head>

  <body>
    <a class="skip-link" href="#main">跳到正文</a>

    <MobileBar />
    <div class="navigation-progress" data-navigation-progress aria-hidden="true"></div>

    <div class="site-shell">
      <main id="main" class:list={['site-main', !isHomePage && 'site-main--inner']}>
        <slot />
        <Footer class="footer--mobile" />
      </main>
      <SiteRail />
    </div>

    <Search />
    <BackToTop />
    <ImageZoom />

    <script>
      import { animateContent, cancelContentMotion } from '@/utils/content-motion'

      let navigationVersion = 0
      let revealObserver: IntersectionObserver | undefined

      function clearNavigationPending() {
        document.documentElement.removeAttribute('data-navigation-pending')
        document.getElementById('main')?.removeAttribute('aria-busy')
      }

      document.addEventListener('astro:before-preparation', (event) => {
        cancelContentMotion()
        const current = ++navigationVersion
        const content = document.getElementById('main')
        const indicator = document.querySelector<HTMLElement>('[data-navigation-progress]')
        if (content && indicator) {
          const rect = content.getBoundingClientRect()
          indicator.style.left = `${rect.left}px`
          indicator.style.width = `${rect.width}px`
          content.setAttribute('aria-busy', 'true')
          document.documentElement.setAttribute('data-navigation-pending', '')
        }
        event.signal.addEventListener('abort', () => {
          if (current === navigationVersion) clearNavigationPending()
        }, { once: true })
      })

      document.addEventListener('astro:before-swap', (event) => {
        cancelContentMotion()
        revealObserver?.disconnect()
        revealObserver = undefined
        // Keep ClientRouter navigation/history without its snapshot overlay.
        event.viewTransition?.ready.catch(() => {})
        event.viewTransition?.skipTransition()
      })
      document.addEventListener('astro:after-swap', clearNavigationPending)

      function initReveal() {
        revealObserver?.disconnect()
        revealObserver = undefined
        const elements = [...document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-visible)')]
        if (!elements.length) return
        if (!('IntersectionObserver' in window)) {
          elements.forEach(element => element.classList.add('is-visible'))
          return
        }

        // Content already in the viewport should not slide in on every refresh;
        // only elements below the fold animate when they are scrolled into view.
        const viewportHeight = window.innerHeight
        const belowFold: HTMLElement[] = []
        for (const element of elements) {
          const rect = element.getBoundingClientRect()
          if (rect.top < viewportHeight && rect.bottom > 0) {
            element.classList.add('is-visible')
          }
          else {
            element.classList.add('is-reveal-pending')
            belowFold.push(element)
          }
        }

        if (!belowFold.length) return
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue
            entry.target.classList.add('is-visible')
            observer.unobserve(entry.target)
          }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 })
        revealObserver = observer
        belowFold.forEach(element => observer.observe(element))
      }

      function initCodeCopy() {
        const blocks = [...document.querySelectorAll<HTMLPreElement>('.prose pre:not([data-copy-ready])')]
        for (const pre of blocks) {
          if (pre.classList.contains('mermaid') || pre.dataset.language === 'mermaid') continue
          const code = pre.querySelector('code')
          if (!code) continue
          pre.dataset.copyReady = 'true'
          const button = document.createElement('button')
          button.type = 'button'
          button.className = 'code-copy'
          button.textContent = '复制'
          button.setAttribute('aria-label', '复制代码')
          button.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(code.textContent ?? '')
              button.textContent = '已复制'
              window.setTimeout(() => { button.textContent = '复制' }, 1600)
            }
            catch {
              button.textContent = '失败'
              window.setTimeout(() => { button.textContent = '复制' }, 1600)
            }
          })
          pre.append(button)
        }
      }

      function rememberNavigation() {
        try {
          const current = location.pathname + location.search
          sessionStorage.setItem('onpaper:immediate-previous', JSON.stringify({
            url: current,
            at: Date.now(),
          }))
          if (!location.pathname.startsWith('/posts/')) {
            sessionStorage.setItem('onpaper:list-context', JSON.stringify({
              url: current,
              scrollY: window.scrollY,
              at: Date.now(),
            }))
          }
        }
        catch (error) {}
      }

      function restoreListScroll() {
        if (document.fonts && document.documentElement.dataset.fontState !== 'ready') return
        try {
          const raw = sessionStorage.getItem('onpaper:restore-scroll')
          if (!raw) return
          const saved = JSON.parse(raw)
          const current = location.pathname + location.search
          if (!saved?.url || saved.url !== current) {
            sessionStorage.removeItem('onpaper:restore-scroll')
            return
          }
          sessionStorage.removeItem('onpaper:restore-scroll')
          window.scrollTo({ top: saved.scrollY || 0, left: 0, behavior: 'instant' })
        }
        catch (error) {}
      }

      function initPage() {
        document.documentElement.classList.add('js')
        if (!document.fonts || document.documentElement.dataset.fontState === 'ready') initReveal()
        initCodeCopy()
        restoreListScroll()
      }

      document.addEventListener('onpaper:content-ready', () => {
        restoreListScroll()
        initReveal()
        if (document.documentElement.hasAttribute('data-font-navigation')) animateContent()
      })
      document.addEventListener('astro:before-swap', rememberNavigation)
      window.addEventListener('pagehide', rememberNavigation)
      document.addEventListener('astro:page-load', initPage)
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPage, { once: true })
      }
      else {
        initPage()
      }
    </script>
  </body>
</html>