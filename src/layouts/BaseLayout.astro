---
import { criticalRuntime } from '@/utils/critical-runtime.mjs'
import { ClientRouter } from 'astro:transitions'
import BackToTop from '@/components/BackToTop.astro'
import Footer from '@/components/Footer.astro'
import FontLoader from '@/components/FontLoader.astro'
import ImageZoom from '@/components/ImageZoom.astro'
import MobileBar from '@/components/MobileBar.astro'
import Search from '@/components/Search.astro'
import SiteRail from '@/components/SiteRail.astro'
import { siteConfig } from '@/config'
import '@/styles/base.css'
import '@/styles/prose.css'
import '@/styles/extensions.css'

interface Props {
  title?: string
  description?: string
  image?: string
  imageWidth?: number
  imageHeight?: number
  article?: boolean
  noindex?: boolean
}

const {
  title,
  description = siteConfig.description,
  image = '/og.png',
  imageWidth = 1200,
  imageHeight = 630,
  article = false,
  noindex = false,
} = Astro.props

const pageTitle = title ? `${title} · ${siteConfig.title}` : `${siteConfig.title} — ${siteConfig.subtitle}`
const canonical = new URL(Astro.url.pathname, siteConfig.url).href
const ogImage = new URL(image, siteConfig.url).href
const ogImageType = image.endsWith('.png')
  ? 'image/png'
  : image.endsWith('.webp')
    ? 'image/webp'
    : image.endsWith('.jpg') || image.endsWith('.jpeg')
      ? 'image/jpeg'
      : undefined
const ogLocale = siteConfig.lang.replace('-', '_')
const { light, dark } = siteConfig.theme
const gaId = siteConfig.analytics.googleAnalyticsId.trim()

const tokenNames: Record<keyof typeof light, string> = {
  paper: '--paper',
  paperRaised: '--paper-raised',
  surface: '--surface',
  surfaceAlt: '--surface-alt',
  ink: '--ink',
  inkSoft: '--ink-soft',
  inkFaint: '--ink-faint',
  line: '--line',
  accent: '--accent',
  accentStrong: '--accent-strong',
  accentSoft: '--accent-soft',
  mark: '--mark',
  selection: '--selection',
}

function tokensToCss(tokens: typeof light) {
  return (Object.keys(tokenNames) as Array<keyof typeof light>)
    .map(key => `${tokenNames[key]}:${tokens[key]};`)
    .join('')
}

const hostedDevelopment = import.meta.env.DEV
const developmentStack = (value: string) => hostedDevelopment ? value.replaceAll('"Newsreader"', '"OnPaper Hosted Newsreader"').replaceAll('"Noto Serif SC"', '"OnPaper Hosted Serif"').replaceAll('"Noto Sans SC"', '"OnPaper Hosted Sans"') : value
const themeCSS = `
:root{${tokensToCss(light)}--font-display-web:${developmentStack(siteConfig.fonts.display)};--font-body-web:${developmentStack(siteConfig.fonts.body)};--font-display:var(--font-display-web);--font-body:var(--font-body-web);--font-mono:${siteConfig.fonts.mono};color-scheme:light}
html[data-theme="dark"]{${tokensToCss(dark)}color-scheme:dark}
@media (prefers-color-scheme: dark){html:not([data-theme="light"]){${tokensToCss(dark)}color-scheme:dark}}
`
---

<!doctype html>
<html
  lang={siteConfig.lang}
  data-default-mode={siteConfig.theme.defaultMode}
  data-theme={siteConfig.theme.defaultMode === 'auto' ? undefined : siteConfig.theme.defaultMode}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <FontLoader />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />
    <meta name="theme-color" content={siteConfig.theme.defaultMode === 'dark' ? dark.paper : light.paper} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.title} RSS`} href="/rss.xml" />
    {hostedDevelopment && <><link rel="preconnect" href="https://fonts.gstatic.cn" crossorigin /><link rel="stylesheet" href="/fonts/hosted-dev.css" /></>}

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={pageTitle} />
    {ogImageType && <meta property="og:image:type" content={ogImageType} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={pageTitle} />
    <slot name="head" />

    <script is:inline define:vars={{
      defaultMode: siteConfig.theme.defaultMode,
      lightPaper: light.paper,
      darkPaper: dark.paper,
    }}>
      (function () {
        document.documentElement.classList.add('js')
        var stored = null
        try { stored = localStorage.getItem('onpaper-theme') } catch (error) {}
        var system = window.matchMedia('(prefers-color-scheme: dark)').matches
        var mode = (stored === 'light' || stored === 'dark') ? stored : defaultMode
        var isDark = mode === 'dark' || (mode === 'auto' && system)
        document.documentElement.dataset.theme = isDark ? 'dark' : 'light'
        document.documentElement.style.colorScheme = isDark ? 'dark' : 'light'
        var meta = document.querySelector('meta[name="theme-color"]')
        if (meta) meta.setAttribute('content', isDark ? darkPaper : lightPaper)

        // ClientRouter swaps the html attributes; re-apply the stored theme to
        // the incoming document before the swap so navigation does not flash.
        document.addEventListener('astro:before-swap', function (event) {
          try {
            if (!event.newDocument) return
            var nextStored = localStorage.getItem('onpaper-theme')
            var nextSystem = window.matchMedia('(prefers-color-scheme: dark)').matches
            var nextMode = (nextStored === 'light' || nextStored === 'dark') ? nextStored : defaultMode
            var nextDark = nextMode === 'dark' || (nextMode === 'auto' && nextSystem)
            event.newDocument.documentElement.classList.add('js')
            event.newDocument.documentElement.dataset.theme = nextDark ? 'dark' : 'light'
            event.newDocument.documentElement.style.colorScheme = nextDark ? 'dark' : 'light'
            var nextMeta = event.newDocument.querySelector('meta[name="theme-color"]')
            if (nextMeta) nextMeta.setAttribute('content', nextDark ? darkPaper : lightPaper)
          }
          catch (error) {}
        })
      })()
    </script>

    <style is:inline set:html={themeCSS}></style>

    {gaId && import.meta.env.PROD && (
      <>
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaId)}`}
        ></script>
        <script is:inline define:vars={{ gaId }}>
          (function () {
            window.dataLayer = window.dataLayer || []
            function gtag() { window.dataLayer.push(arguments) }
            window.gtag = gtag
            gtag('js', new Date())
            // Astro's ClientRouter changes the URL without a full reload, so
            // send page_view explicitly on every astro:page-load instead of
            // relying on gtag's initial automatic page view.
            gtag('config', gaId, { send_page_view: false })
            var lastUrl = ''
            function trackPageView() {
              if (location.href === lastUrl) return
              lastUrl = location.href
              gtag('event', 'page_view', {
                page_location: location.href,
                page_title: document.title,
              })
            }
            document.addEventListener('astro:page-load', trackPageView)
            trackPageView()
          })()
        </script>
      </>
    )}

    <ClientRouter fallback="swap" />
  </head>

  <body>
    <!-- Keep email links readable when Cloudflare decoding scripts are unavailable. -->
    <Fragment set:html="<!--email_off-->" />
    <a class="skip-link" href="#main">跳到正文</a>

    <MobileBar />

    <div class="site-shell">
      <SiteRail />
      <main id="main" class="site-main">
        <slot />
        <Footer />
      </main>
    </div>

    <!-- Labels inserted by copy controls must be ready before their first paint. -->
    <span hidden aria-hidden="true" data-font-ui-text>复制已失败</span>
    <div class="page-turn" aria-hidden="true" transition:persist="page-turn"><div class="page-turn__sheet"></div></div>
    <div class="route-ink" aria-hidden="true" transition:persist="route-ink"><span></span></div>
    <Search />
    <BackToTop />
    <ImageZoom />

    <script>
      import { installNavigation } from '@/utils/navigation'

      installNavigation()

      let revealObserver: IntersectionObserver | undefined

      document.addEventListener('astro:before-swap', (event) => {
        leavingIndicators = captureIndicators()
        revealObserver?.disconnect()
        revealObserver = undefined
        // Keep ClientRouter navigation/history without its snapshot overlay.
        event.viewTransition?.ready.catch(() => {})
        event.viewTransition?.skipTransition()
      })

      function initReveal() {
        if (document.documentElement.dataset.fontState === 'loading') return
        revealObserver?.disconnect()
        revealObserver = undefined
        const elements = [...document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-visible)')]
        if (!elements.length) return
        if (!('IntersectionObserver' in window)) {
          elements.forEach(element => element.classList.add('is-visible'))
          return
        }

        // Content already in the viewport should not slide in on every refresh;
        // only elements below the fold animate when they are scrolled into view.
        const viewportHeight = window.innerHeight
        const belowFold: HTMLElement[] = []
        for (const element of elements) {
          const rect = element.getBoundingClientRect()
          if (rect.top < viewportHeight && rect.bottom > 0) {
            element.classList.add('is-visible')
          }
          else {
            element.classList.add('is-reveal-pending')
            belowFold.push(element)
          }
        }

        if (!belowFold.length) return
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue
            entry.target.classList.add('is-visible')
            observer.unobserve(entry.target)
          }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 })
        revealObserver = observer
        belowFold.forEach(element => observer.observe(element))
      }

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

      // The button that was pressed confirms the copy itself, then settles
      // back. A quick blur bridges the label swap instead of a hard cut.
      function swapLabel(button: HTMLButtonElement, state: 'copied' | 'failed' | '', label: string) {
        if (state) button.dataset.state = state
        else delete button.dataset.state
        button.replaceChildren()
        if (state === 'copied') {
          const check = document.createElementNS('http://www.w3.org/2000/svg', 'svg')
          check.setAttribute('viewBox', '0 0 16 16')
          check.setAttribute('class', 'code-copy__check')
          check.setAttribute('aria-hidden', 'true')
          check.innerHTML = '<path d="m3.5 8.5 3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>'
          button.append(check)
        }
        button.append(label)
        if (!reducedMotion.matches) {
          button.animate(
            [{ opacity: 0.2, filter: 'blur(2px)' }, { opacity: 1, filter: 'blur(0)' }],
            { duration: 180, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
          )
        }
      }

      function initCodeCopy() {
        const blocks = [...document.querySelectorAll<HTMLPreElement>('.prose pre:not([data-copy-ready])')]
        for (const pre of blocks) {
          if (pre.classList.contains('mermaid') || pre.dataset.language === 'mermaid') continue
          const code = pre.querySelector('code')
          if (!code) continue
          pre.dataset.copyReady = 'true'
          const button = document.createElement('button')
          button.type = 'button'
          button.className = 'code-copy'
          button.textContent = '复制'
          button.setAttribute('aria-label', '复制代码')
          let resetTimer: number | undefined
          button.addEventListener('click', async () => {
            window.clearTimeout(resetTimer)
            try {
              await navigator.clipboard.writeText(code.textContent ?? '')
              swapLabel(button, 'copied', '已复制')
            }
            catch {
              swapLabel(button, 'failed', '复制失败')
            }
            resetTimer = window.setTimeout(() => swapLabel(button, '', '复制'), 1800)
          })
          pre.append(button)
        }
      }

      // Navigation indicators travel from the section you left to the one
      // you arrived at, so the change of place is visible, not a jump.
      type IndicatorRects = Map<string, DOMRect>
      let leavingIndicators: IndicatorRects | undefined
      const markOf = (nav: HTMLElement) => nav.dataset.navIndicator === 'y' ? '::before' : '::after'
      function captureIndicators(): IndicatorRects {
        const rects: IndicatorRects = new Map()
        document.querySelectorAll<HTMLElement>('[data-nav-indicator]').forEach((nav) => {
          const active = nav.querySelector<HTMLElement>('a[aria-current="page"]')
          if (!active || !active.getClientRects().length) return
          const rect = active.getBoundingClientRect()
          // Start from where the mark is drawn now, which may be leaning
          // towards a hovered item rather than sitting under the current one.
          const drawn = getComputedStyle(active, markOf(nav)).transform
          const m = drawn && drawn !== 'none' ? new DOMMatrixReadOnly(drawn) : new DOMMatrixReadOnly()
          rects.set(nav.dataset.navIndicator!, new DOMRect(rect.x + m.m41, rect.y + m.m42, rect.width * m.m11, rect.height))
        })
        return rects
      }

      // The ink mark leans towards the section under the pointer (or keyboard
      // focus) and returns to the current one on leave.
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)')
      function initNavFollow() {
        document.querySelectorAll<HTMLElement>('[data-nav-indicator]').forEach((nav) => {
          if (nav.dataset.follow === 'true') return
          nav.dataset.follow = 'true'
          const axis = nav.dataset.navIndicator
          let motion: Animation | undefined
          const moveTo = (target: HTMLElement | null) => {
            const current = nav.querySelector<HTMLElement>('a[aria-current="page"]')
            if (!current || reducedMotion.matches) return
            const pseudoElement = markOf(nav)
            const from = getComputedStyle(current, pseudoElement).transform
            const goal = target && target !== current ? target : current
            const to = axis === 'y'
              ? `translateY(${goal.offsetTop - current.offsetTop}px)`
              : `translateX(${goal.offsetLeft - current.offsetLeft}px) scaleX(${goal.offsetWidth / current.offsetWidth})`
            motion?.cancel()
            motion = current.animate([
              { transform: from && from !== 'none' ? from : 'none', opacity: 1 },
              { transform: to, opacity: 1 },
            ], { duration: goal === current ? 340 : 260, easing: 'cubic-bezier(0.25, 1, 0.5, 1)', pseudoElement, fill: 'forwards' })
          }
          nav.addEventListener('pointerover', (event) => {
            if (!finePointer.matches) return
            const link = (event.target as Element).closest<HTMLElement>('a')
            if (link) moveTo(link)
          })
          nav.addEventListener('pointerleave', () => moveTo(null))
          nav.addEventListener('focusin', (event) => {
            const link = (event.target as Element).closest<HTMLElement>('a')
            if (link?.matches(':focus-visible')) moveTo(link)
          })
          nav.addEventListener('focusout', (event) => {
            if (!nav.contains(event.relatedTarget as Node | null)) moveTo(null)
          })
        })
      }
      function moveIndicators(previous: IndicatorRects | undefined) {
        if (!previous || reducedMotion.matches) return
        document.querySelectorAll<HTMLElement>('[data-nav-indicator]').forEach((nav) => {
          const axis = nav.dataset.navIndicator as 'x' | 'y'
          const from = previous.get(axis)
          const active = nav.querySelector<HTMLElement>('a[aria-current="page"]')
          if (!from || !active || !active.getClientRects().length) return
          const to = active.getBoundingClientRect()
          if (Math.abs(from.top - to.top) < 1 && Math.abs(from.left - to.left) < 1) return
          const pseudoElement = axis === 'y' ? '::before' : '::after'
          const offset = axis === 'y'
            ? `translateY(${from.top - to.top}px)`
            : `translateX(${from.left - to.left}px) scaleX(${from.width / to.width})`
          active.animate(
            [{ transform: offset, opacity: 1 }, { transform: 'none', opacity: 1 }],
            { duration: 340, easing: 'cubic-bezier(0.25, 1, 0.5, 1)', pseudoElement },
          )
        })
      }

      // Route ink: runs while the next page loads, completes and lifts when it
      // is readable. Nothing waits for it; it only shows the wait.
      let inkRun: Animation | undefined
      function routeInk(phase: 'start' | 'end') {
        const bar = document.querySelector<HTMLElement>('.route-ink > span')
        if (!bar || reducedMotion.matches) return
        const scale = window.matchMedia('(min-width: 1101px)').matches ? 'scaleY' : 'scaleX'
        if (phase === 'start') {
          inkRun?.cancel()
          inkRun = bar.animate([
            { transform: `${scale}(0)`, opacity: 1 },
            { transform: `${scale}(0.85)`, opacity: 1 },
          ], { duration: 1800, easing: 'cubic-bezier(0.1, 0.75, 0.2, 1)', fill: 'forwards' })
          return
        }
        if (!inkRun) return
        const from = getComputedStyle(bar).transform
        inkRun.cancel()
        const finish = bar.animate([
          { transform: from === 'none' ? `${scale}(0)` : from, opacity: 1 },
          { transform: `${scale}(1)`, opacity: 1, offset: 0.4 },
          { transform: `${scale}(1)`, opacity: 0 },
        ], { duration: 560, easing: 'ease-out', fill: 'forwards' })
        inkRun = finish
        finish.finished.then(() => { if (inkRun === finish) { finish.cancel(); inkRun = undefined } }, () => {})
      }
      // Page turn: the incoming page is revealed by turning a sheet of paper
      // away from it. It starts on the first frame the new page is readable
      // and never delays navigation, focus or input.
      let turnDirection: 'forward' | 'back' = 'forward'
      let turn: Animation | undefined
      function turnPage() {
        const sheet = document.querySelector<HTMLElement>('.page-turn__sheet')
        if (!sheet || reducedMotion.matches) return
        turn?.cancel()
        sheet.dataset.direction = turnDirection
        const away = turnDirection === 'back' ? 'translateX(calc(100% + 4rem))' : 'translateX(calc(-100% - 4rem))'
        turn = sheet.animate([
          { transform: 'none', visibility: 'visible' },
          { transform: away, visibility: 'visible' },
        ], { duration: 620, easing: 'cubic-bezier(0.32, 0.72, 0, 1)' })
      }

      document.addEventListener('astro:before-preparation', (event) => {
        turnDirection = event.direction === 'back' ? 'back' : 'forward'
        routeInk('start')
        event.signal?.addEventListener('abort', () => routeInk('end'), { once: true })
      })


      function rememberNavigation() {
        try {
          const current = location.pathname + location.search
          sessionStorage.setItem('onpaper:immediate-previous', JSON.stringify({
            url: current,
            at: Date.now(),
          }))
          if (!location.pathname.startsWith('/posts/')) {
            sessionStorage.setItem('onpaper:list-context', JSON.stringify({
              url: current,
              scrollY: window.scrollY,
              at: Date.now(),
            }))
          }
        }
        catch (error) {}
      }

      function restoreListScroll() {
        if (document.documentElement.dataset.fontState === 'loading') return
        try {
          const raw = sessionStorage.getItem('onpaper:restore-scroll')
          if (!raw) return
          const saved = JSON.parse(raw)
          const current = location.pathname + location.search
          if (!saved?.url || saved.url !== current) {
            sessionStorage.removeItem('onpaper:restore-scroll')
            return
          }
          sessionStorage.removeItem('onpaper:restore-scroll')
          window.scrollTo({ top: saved.scrollY || 0, left: 0, behavior: 'instant' })
        }
        catch (error) {}
      }

      function initPage() {
        document.documentElement.classList.add('js')
        initNavFollow()
        initReveal()
        initCodeCopy()
        restoreListScroll()
      }

      document.addEventListener('onpaper:content-ready', () => {
        restoreListScroll()
        initReveal()
        if (!document.documentElement.hasAttribute('data-font-navigation')) return
        turnPage()
        routeInk('end')
        moveIndicators(leavingIndicators)
        leavingIndicators = undefined
      })
      document.addEventListener('astro:before-swap', rememberNavigation)
      window.addEventListener('pagehide', rememberNavigation)
      document.addEventListener('astro:page-load', initPage)
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPage, { once: true })
      }
      else {
        initPage()
      }
    </script>
    <script is:inline set:html={criticalRuntime()} />
    <script is:inline>window.__onpaperFonts?.start()</script>
    <Fragment set:html="<!--/email_off-->" />
  </body>
</html>
