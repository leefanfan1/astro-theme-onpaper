---
import ThemeToggle from '@/components/ThemeToggle.astro'
import { siteConfig } from '@/config'
import { t } from '@/i18n'
import T from '@/components/T.astro'
import { isNavActive, navItems as resolveNav } from '@/utils/nav'

const pathname = Astro.url.pathname
const nav = resolveNav(pathname)
// Set vertically, the subtitle breaks where its punctuation pauses; the
// full sentence (with punctuation) stays available to screen readers.
const subtitleLines = siteConfig.subtitle.split(/[，。、；！？,.;!?\s]+/).filter(Boolean)
---

<!-- The spine: the site's name stands upright on its own panel, like the
     title on a book's spine. Everything in it shares one centre line. -->
<aside class="site-rail" aria-label={t('aside.label')}>
  <div class="rail-masthead">
    <a class="rail-wordmark" href="/" aria-label={`${siteConfig.title} ${t('common.siteHome')}`} data-wordmark>
      <span class="rail-wordmark__cn" aria-hidden="true" style={`--chars:${[...siteConfig.title].length}`}>{[...siteConfig.title].map(char => <span>{char}</span>)}</span>
    </a>
    <p class="rail-subtitle">
      <span class="sr-only">{siteConfig.subtitle}</span>
      <span class="rail-subtitle__lines" aria-hidden="true">{subtitleLines.map(line => <span>{[...line].map(char => <span>{char}</span>)}</span>)}</span>
    </p>
  </div>

  <nav aria-label={t('nav.home')}>
    <ul class="rail-nav" data-nav-indicator="y">
      {nav.map(item => (
        <li>
          <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="rail-actions">
    <button class="text-button" type="button" data-search-trigger aria-haspopup="dialog">
      <svg class="text-button__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="10.8" cy="10.8" r="6.3" stroke="currentColor" stroke-width="1.6"></circle>
        <path d="m15.5 15.5 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      </svg>
      <span class="text-button__label"><T k="common.search" /></span>
    </button>
    <ThemeToggle />
  </div>
</aside>
