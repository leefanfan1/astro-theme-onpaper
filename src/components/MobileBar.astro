---
import ThemeToggle from '@/components/ThemeToggle.astro'
import { siteConfig } from '@/config'

const pathname = Astro.url.pathname
const isArticle = pathname.startsWith('/posts')
const isArticleList = pathname === '/' || pathname.startsWith('/page/') || isArticle

const nav = siteConfig.nav.map((item) => {
  const active = item.href === '/'
    ? isArticleList
    : pathname.startsWith(item.href)
  return { ...item, active }
})
---

<header
  class:list={['mobile-bar', isArticle && 'mobile-bar--article']}
  data-mobile-bar
  data-article-bar={isArticle ? 'true' : undefined}
>
  <div class="mobile-bar__inner">
    <div class="mobile-bar__top">
      <a class="rail-wordmark" href="/" aria-label={`${siteConfig.title} 首页`}>
        <span class="rail-wordmark__cn">{siteConfig.title}</span>
      </a>
      <div class="mobile-bar__actions">
        <button class="text-button text-button--icon" type="button" data-search-trigger aria-label="打开搜索">
          <svg class="text-button__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="10.8" cy="10.8" r="6.3" stroke="currentColor" stroke-width="1.6"></circle>
            <path d="m15.5 15.5 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
        </button>
        <ThemeToggle />
      </div>
    </div>
    <nav class="mobile-nav" aria-label="移动端导航">
      {nav.map(item => (
        <a href={item.href} aria-current={item.active ? 'page' : undefined}><span class="mobile-nav__label">{item.label}</span></a>
      ))}
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var bar = document.querySelector('[data-mobile-bar]')
    if (bar) document.documentElement.style.setProperty('--mobile-bar-height', bar.offsetHeight + 'px')
  })()
</script>

<div class="mobile-bar-spacer" aria-hidden="true"></div>

<script>
  let measuredWidth = -1
  let resizeFrame = 0
  let scrollFrame = 0

  function measureBarHeight() {
    const bar = document.querySelector<HTMLElement>('[data-mobile-bar]')
    if (!bar) return
    if (window.innerWidth > 1100) { measuredWidth = window.innerWidth; return }
    // Never measure the live bar while its compact transition is running.
    // A hidden, expanded copy keeps the content spacer stable at full height.
    const probe = bar.cloneNode(true) as HTMLElement
    probe.removeAttribute('data-mobile-bar')
    probe.classList.remove('is-compact')
    probe.setAttribute('data-bar-measuring', '')
    probe.setAttribute('aria-hidden', 'true')
    probe.inert = true
    probe.querySelectorAll('[id]').forEach(element => element.removeAttribute('id'))
    bar.after(probe)
    const height = probe.getBoundingClientRect().height
    probe.remove()
    document.documentElement.style.setProperty('--mobile-bar-height', height + 'px')
    measuredWidth = window.innerWidth
  }

  function updateBar() {
    const bar = document.querySelector<HTMLElement>('[data-mobile-bar]')
    if (!bar) return
    const y = window.scrollY
    bar.classList.toggle('is-scrolled', y > 8)

    if (bar.dataset.articleBar === 'true') {
      if (y <= 24) bar.classList.remove('is-compact')
      else if (y > 120) bar.classList.add('is-compact')
    }
    else {
      bar.classList.remove('is-compact')
    }
  }

  function refreshBar() {
    measureBarHeight()
    updateBar()
  }

  function onScroll() {
    if (scrollFrame) return
    scrollFrame = requestAnimationFrame(() => { scrollFrame = 0; updateBar() })
  }

  function onResize() {
    // Mobile browser toolbars change viewport height while scrolling. They do
    // not change the bar's layout width and must not rewrite its spacer.
    if (window.innerWidth === measuredWidth || resizeFrame) return
    resizeFrame = requestAnimationFrame(() => { resizeFrame = 0; refreshBar() })
  }

  document.addEventListener('astro:page-load', refreshBar)
  document.addEventListener('onpaper:fonts-ready', refreshBar)
  window.addEventListener('scroll', onScroll, { passive: true })
  window.addEventListener('resize', onResize, { passive: true })
  document.fonts?.ready.then(refreshBar)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', refreshBar, { once: true })
  }
  else {
    refreshBar()
  }
</script>