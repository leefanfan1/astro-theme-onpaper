---
import { siteConfig } from '@/config'

const year = new Date().getFullYear()
const range = siteConfig.startYear === year ? String(year) : `${siteConfig.startYear}–${year}`
---

<footer class="footer">
  <div class="footer__socials">
    {siteConfig.socials.map(link => (
      <a
        href={link.href}
        target={link.external ? '_blank' : undefined}
        rel={link.external ? 'noopener noreferrer' : undefined}
      >{link.label}</a>
    ))}
  </div>
  <div class="footer__credit">
    <p>© {range} {siteConfig.author}</p>
    <p>用 <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">Astro</a> 搭建，主题 <a href="https://github.com/leefanfan1/astro-theme-onpaper" target="_blank" rel="noopener noreferrer">纸上留白</a></p>
  </div>
</footer>
