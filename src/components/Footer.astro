---
import { siteConfig } from '@/config'
import T from '@/components/T.astro'

const year = new Date().getFullYear()
const range = siteConfig.startYear === year ? String(year) : `${siteConfig.startYear}–${year}`
---

<footer class="footer">
  <div class="footer__socials">
    {siteConfig.socials.map(link => (
      <a
        href={link.href}
        target={link.external ? '_blank' : undefined}
        rel={link.external ? 'noopener noreferrer' : undefined}
      >{link.label}</a>
    ))}
  </div>
  <div class="footer__credit">
    <p>© {range} {siteConfig.author}</p>
    <p><T k="footer.poweredBy" /> · <a href="https://github.com/leefanfan1/astro-theme-onpaper" target="_blank" rel="noopener noreferrer">{siteConfig.title}</a></p>
  </div>
</footer>
