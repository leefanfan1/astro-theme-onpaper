---
import CheckIcon from '@/assets/icons/copy-check.svg'
import InstagramIcon from '@/assets/icons/instagram-icon.svg'
import LinkIcon from '@/assets/icons/link-icon.svg'
import TelegramIcon from '@/assets/icons/telegram-icon.svg'
import ThreadsIcon from '@/assets/icons/threads-icon.svg'
import XIcon from '@/assets/icons/twitter-icon.svg'
import WechatIcon from '@/assets/icons/wechat-icon.svg'
import WeiboIcon from '@/assets/icons/weibo-icon.svg'

interface Props {
  title: string
  url: string
}

const { title, url } = Astro.props
const encodedTitle = encodeURIComponent(title)
const encodedUrl = encodeURIComponent(url)
const xHref = `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`
const telegramHref = `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`
const weiboHref = `https://service.weibo.com/share/share.php?title=${encodedTitle}&url=${encodedUrl}`
const threadsHref = `https://www.threads.net/intent/post?text=${encodeURIComponent(`${title} ${url}`)}`
---

<div class="share-bar" aria-label="分享这篇文章">
  <span class="share-bar__label">分享</span>

  <a class="share-button" href={xHref} target="_blank" rel="noopener noreferrer" aria-label="分享到 X" title="X">
    <XIcon fill="currentColor" aria-hidden="true" />
  </a>
  <a class="share-button" href={telegramHref} target="_blank" rel="noopener noreferrer" aria-label="分享到 Telegram" title="Telegram">
    <TelegramIcon fill="currentColor" aria-hidden="true" />
  </a>
  <a class="share-button" href={weiboHref} target="_blank" rel="noopener noreferrer" aria-label="分享到微博" title="微博">
    <WeiboIcon fill="currentColor" aria-hidden="true" />
  </a>
  <a class="share-button" href={threadsHref} target="_blank" rel="noopener noreferrer" aria-label="分享到 Threads" title="Threads">
    <ThreadsIcon fill="currentColor" aria-hidden="true" />
  </a>

  <button class="share-button" type="button" data-share-native aria-label="分享到 Instagram" title="Instagram">
    <InstagramIcon fill="currentColor" aria-hidden="true" />
  </button>
  <button class="share-button" type="button" data-share-native aria-label="分享到微信" title="微信">
    <WechatIcon fill="currentColor" aria-hidden="true" />
  </button>

  <button class="share-button" type="button" data-share-copy aria-label="复制链接" title="复制链接">
    <LinkIcon class="share-icon share-icon--link" fill="currentColor" aria-hidden="true" />
    <CheckIcon class="share-icon share-icon--check" fill="currentColor" aria-hidden="true" />
  </button>

  <span class="share-status" data-share-status aria-live="polite"></span>
</div>

<style is:global>
  .share-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.15rem;
    margin-top: 1.2rem;
  }

  .share-bar__label {
    margin-right: 0.55rem;
    padding-right: 0.6rem;
    border-right: 1px solid var(--line);
    color: var(--ink-faint);
    font-size: 0.64rem;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .share-button {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: color-mix(in oklab, var(--ink-soft) 62%, transparent);
    transition: color 0.2s ease, background 0.2s ease;
  }

  .share-button:hover {
    color: var(--ink);
    background: var(--surface);
  }

  .share-button svg {
    width: 1rem;
    height: 1rem;
  }

  .share-icon--check {
    display: none;
  }

  .share-button.copied {
    color: var(--accent-strong);
    background: var(--accent-soft);
  }

  .share-button.copied .share-icon--link {
    display: none;
  }

  .share-button.copied .share-icon--check {
    display: block;
  }

  .share-status {
    margin-left: 0.35rem;
    color: var(--accent-strong);
    font-size: 0.68rem;
  }

  .share-status:empty {
    display: none;
  }

  @media (pointer: coarse) {
    .share-button {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  @media (max-width: 700px) {
    .share-bar {
      display: grid;
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: 0.15rem;
      width: 100%;
    }

    .share-bar__label {
      grid-column: 1 / -1;
      margin: 0 0 0.15rem;
      padding: 0;
      border-right: 0;
    }

    .share-status {
      grid-column: 1 / -1;
      margin: 0.1rem 0 0;
    }

    .share-button {
      width: 100%;
      max-width: 2.75rem;
      height: auto;
      aspect-ratio: 1;
      justify-self: center;
    }
  }
</style>

<script>
  async function copyCurrentUrl(status: HTMLElement | null, button: Element | null) {
    try {
      await navigator.clipboard.writeText(window.location.href)
      button?.classList.add('copied')
      if (status) {
        status.textContent = '已复制'
        window.setTimeout(() => { status.textContent = '' }, 1800)
      }
      window.setTimeout(() => button?.classList.remove('copied'), 1800)
    }
    catch {
      if (status) {
        status.textContent = '复制失败'
        window.setTimeout(() => { status.textContent = '' }, 1800)
      }
    }
  }

  document.addEventListener('click', async (event) => {
    const target = event.target
    if (!(target instanceof Element)) return

    const status = document.querySelector<HTMLElement>('[data-share-status]')
    const copyButton = target.closest('[data-share-copy]')

    if (copyButton) {
      await copyCurrentUrl(status, copyButton)
      return
    }

    if (target.closest('[data-share-native]')) {
      try {
        await navigator.share({ title: document.title, url: window.location.href })
      }
      catch {
        await copyCurrentUrl(status, null)
      }
    }
  })
</script>