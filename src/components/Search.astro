---
const searchIndexUrl = `${import.meta.env.BASE_URL}search.json`
---

<dialog
  class="search-dialog"
  id="search-dialog"
  data-search-dialog
  data-index-url={searchIndexUrl}
  aria-label="搜索文章"
>
  <div class="search-dialog__bar">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="10.8" cy="10.8" r="6.3" stroke="currentColor" stroke-width="1.5"></circle>
      <path d="m15.5 15.5 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
    </svg>
    <input
      type="search"
      id="search-input"
      placeholder="搜索标题、标签或正文…"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="search"
      aria-label="搜索关键词"
    />
    <button class="search-close" type="button" data-search-close aria-label="关闭搜索（Esc）">
      Esc
    </button>
  </div>
  <!-- Keep dynamic UI labels in the initial font set, including on weak networks. -->
  <span hidden aria-hidden="true" data-search-font-text>正在建立索引…搜索索引加载失败，请刷新页面重试。没有找到与“”相关的文章。条搜索结果</span>
  <div class="sr-only" data-search-status aria-live="polite"></div>
  <div class="search-results" data-search-results>
    <p class="search-hint">输入关键词，搜索标题、摘要、标签和正文。</p>
  </div>
</dialog>

<style is:global>
  /* The search sheet drops in just below the top edge. Entry uses
     @starting-style; the exit runs while .is-closing keeps the dialog in the
     top layer, then the script closes it. Transitions (not keyframes) let a
     reopen during the exit reverse smoothly from wherever it is. */
  .search-dialog {
    position: fixed;
    inset: 0;
    z-index: 300;
    width: min(40rem, calc(100vw - 2rem));
    max-height: min(76vh, 42rem);
    margin: 12vh auto auto;
    padding: 0;
    overflow: hidden;
    border: var(--border);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
    color: var(--ink);
    box-shadow: var(--shadow-float);
    opacity: 0;
    transition:
      opacity var(--dur-exit) ease,
      transform var(--dur-exit) ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    .search-dialog {
      transform: translateY(-6px) scale(0.985);
    }
  }

  .search-dialog[open]:not(.is-closing) {
    opacity: 1;
    transform: none;
    transition:
      opacity var(--dur-pop) var(--ease-out),
      transform var(--dur-move) var(--ease-out);
  }

  @starting-style {
    .search-dialog[open]:not(.is-closing) {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @starting-style {
      .search-dialog[open]:not(.is-closing) {
        transform: translateY(-10px) scale(0.98);
      }
    }
  }

  .search-dialog.is-closing {
    pointer-events: none;
  }

  .search-dialog::backdrop {
    background: color-mix(in srgb, var(--ink) 0%, transparent);
    transition: background-color var(--dur-exit) ease;
  }

  .search-dialog[open]:not(.is-closing)::backdrop {
    background: color-mix(in srgb, #0b0f17 34%, transparent);
    transition: background-color var(--dur-pop) var(--ease-out);
  }

  @starting-style {
    .search-dialog[open]:not(.is-closing)::backdrop {
      background: color-mix(in srgb, #0b0f17 0%, transparent);
    }
  }

  html[data-theme="dark"] .search-dialog[open]:not(.is-closing)::backdrop {
    background: color-mix(in srgb, #05070b 55%, transparent);
  }

  .search-dialog__bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0.7rem 0.75rem 0.7rem 1.1rem;
    border-bottom: var(--border);
  }

  /* The input drops its own outline; the whole bar shows focus instead. */
  .search-dialog__bar:has(input:focus-visible) {
    border-bottom-color: var(--accent);
    box-shadow: inset 0 -1px 0 var(--accent);
  }

  .search-dialog__bar > svg {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    color: var(--ink-faint);
  }

  .search-dialog input {
    flex: 1;
    min-width: 0;
    min-height: 2.75rem;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--ink);
    font-size: var(--text-base);
  }

  .search-dialog input::placeholder {
    color: var(--ink-faint);
  }

  .search-dialog input::-webkit-search-cancel-button {
    display: none;
  }

  .search-close {
    flex: none;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding-inline: 0.6rem;
    border-radius: var(--radius-md);
    color: var(--ink-faint);
    font-size: var(--text-2xs);
    letter-spacing: 0.06em;
    transition: color var(--dur-hover) ease, background-color var(--dur-hover) ease;
  }

  .search-close:active {
    transform: scale(0.96);
  }

  @media (hover: hover) and (pointer: fine) {
    .search-close:hover {
      color: var(--ink);
      background: color-mix(in srgb, var(--ink) 6%, transparent);
    }
  }

  .search-results {
    max-height: calc(min(76vh, 42rem) - 4.3rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--space-2);
    scrollbar-width: thin;
  }

  .search-hint,
  .search-empty {
    padding: 2.5rem 1rem;
    color: var(--ink-faint);
    font-size: var(--text-sm);
    line-height: 1.7;
    text-align: center;
  }

  .search-result {
    position: relative;
    display: grid;
    gap: 0.2rem;
    padding: 0.8rem 0.9rem;
    border-radius: var(--radius-md);
    transition: background-color var(--dur-hover) ease;
  }

  .search-result + .search-result {
    margin-top: 2px;
  }

  .search-result:focus-visible {
    outline-offset: -2px;
  }

  .search-result:hover,
  .search-result:focus-visible {
    background: var(--surface);
    transition-duration: 0s;
  }

  .search-result__title {
    color: var(--ink);
    font-size: var(--text-md);
    font-weight: 600;
    line-height: 1.5;
  }

  .search-result__meta {
    color: var(--ink-faint);
    font-size: var(--text-2xs);
    font-variant-numeric: tabular-nums;
  }

  .search-result__excerpt {
    display: -webkit-box;
    overflow: hidden;
    color: var(--ink-soft);
    font-size: var(--text-xs);
    line-height: 1.7;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .search-result mark {
    padding: 0 0.08em;
    border-radius: 2px;
    background: var(--mark);
    color: inherit;
  }

  body.search-open {
    overflow: hidden;
  }

  @media (max-width: 520px) {
    .search-dialog {
      width: calc(100vw - 1rem);
      max-height: 80vh;
      margin-top: 0.5rem;
    }

    .search-results {
      max-height: calc(80vh - 4.3rem);
    }
  }
</style>
