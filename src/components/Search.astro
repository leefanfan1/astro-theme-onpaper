---
const searchIndexUrl = `${import.meta.env.BASE_URL}search.json`
---

<dialog
  class="search-dialog"
  id="search-dialog"
  data-search-dialog
  data-index-url={searchIndexUrl}
  aria-label="搜索文章"
>
  <div class="search-dialog__bar">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="10.8" cy="10.8" r="6.3" stroke="currentColor" stroke-width="1.5"></circle>
      <path d="m15.5 15.5 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
    </svg>
    <input
      type="search"
      id="search-input"
      placeholder="搜索标题、标签或正文…"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="search"
      aria-label="搜索关键词"
    />
    <button class="search-close" type="button" data-search-close aria-label="关闭搜索（Esc）">
      Esc
    </button>
  </div>
  <!-- Keep dynamic UI labels in the initial font set, including on weak networks. -->
  <span hidden aria-hidden="true" data-search-font-text>正在建立索引…搜索索引加载失败，请刷新页面重试。没有找到与“”相关的文章。条搜索结果</span>
  <div class="sr-only" data-search-status aria-live="polite"></div>
  <div class="search-results" data-search-results>
    <p class="search-hint">输入关键词，搜索标题、摘要、标签和正文。</p>
  </div>
</dialog>

<style is:global>
  .search-dialog {
    position: fixed;
    inset: 0;
    z-index: 300;
    width: min(42rem, calc(100vw - 2rem));
    max-height: min(78vh, 44rem);
    margin: auto;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 24px 70px rgb(0 0 0 / 0.18);
  }

  .search-dialog::backdrop {
    background: color-mix(in oklab, var(--ink) 28%, transparent);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .search-dialog[open] {
    animation: search-in 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .search-dialog[open]::backdrop {
    animation: search-backdrop-in 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .search-dialog.is-closing {
    animation: search-out 0.24s cubic-bezier(0.4, 0, 1, 1) both;
    pointer-events: none;
  }

  .search-dialog.is-closing::backdrop {
    animation: search-backdrop-out 0.24s cubic-bezier(0.4, 0, 1, 1) both;
  }

  @keyframes search-in {
    from {
      opacity: 0;
      transform: scale(0.985);
    }
  }

  @keyframes search-out {
    to {
      opacity: 0;
      transform: scale(0.99);
    }
  }

  @keyframes search-backdrop-in {
    from {
      opacity: 0;
      backdrop-filter: blur(0);
      -webkit-backdrop-filter: blur(0);
    }
  }

  @keyframes search-backdrop-out {
    to {
      opacity: 0;
      backdrop-filter: blur(0);
      -webkit-backdrop-filter: blur(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-dialog[open],
    .search-dialog.is-closing,
    .search-dialog[open]::backdrop,
    .search-dialog.is-closing::backdrop {
      animation: none;
    }
  }

  .search-dialog__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--line);
  }

  .search-dialog__bar > svg {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    color: var(--ink-faint);
  }

  .search-dialog input {
    flex: 1;
    min-width: 0;
    min-height: 2.5rem;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--ink);
    font-size: 1.02rem;
  }

  .search-dialog input::placeholder {
    color: var(--ink-faint);
  }

  .search-dialog input::-webkit-search-cancel-button {
    display: none;
  }

  .search-close {
    flex: none;
    min-width: 2.5rem;
    min-height: 2.5rem;
    padding-inline: 0.55rem;
    border: 1px solid var(--line);
    border-radius: 3px;
    color: var(--ink-faint);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
  }

  .search-close:hover {
    color: var(--accent-strong);
    border-color: var(--accent);
  }

  .search-results {
    max-height: calc(78vh - 4.6rem);
    overflow-y: auto;
    padding: 0.4rem;
    scrollbar-width: thin;
  }

  .search-hint,
  .search-empty {
    padding: 2.6rem 1rem;
    color: var(--ink-faint);
    font-size: 0.8rem;
    line-height: 1.7;
    text-align: center;
  }

  .search-result {
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
    padding: 0.72rem 0.8rem;
    border-radius: 3px;
    transition: background 0.15s ease;
  }

  .search-result:hover,
  .search-result:focus-visible {
    background: var(--surface);
  }

  .search-result__title {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.04rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .search-result__meta {
    color: var(--ink-faint);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
  }

  .search-result__excerpt {
    display: -webkit-box;
    overflow: hidden;
    color: var(--ink-soft);
    font-size: 0.77rem;
    line-height: 1.6;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .search-result mark {
    padding: 0 0.1em;
    background: color-mix(in oklab, var(--accent) 22%, transparent);
    color: var(--accent-strong);
  }

  body.search-open {
    overflow: hidden;
  }

  @media (max-width: 520px) {
    .search-dialog {
      width: calc(100vw - 1rem);
      max-height: 82vh;
    }

    .search-results {
      max-height: calc(82vh - 4.6rem);
    }
  }
</style>
