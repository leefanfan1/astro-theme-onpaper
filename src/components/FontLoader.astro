---
// Keep fallback text out of the first paint, including slow font responses.
---

<script is:inline>
  if (document.fonts && document.documentElement.dataset.fontState !== 'ready')
    document.documentElement.dataset.fontState = 'loading'
</script>

<style is:global>
  html[data-font-state='loading'] body,
  html[data-font-state='error'] body { visibility: hidden; }

  /* The rail's fonts are already loaded during client navigation. Keep it
     visible while the incoming content waits for any new glyph subsets. */
  html[data-font-navigation][data-font-state='loading'] body,
  html[data-font-navigation][data-font-state='error'] body { visibility: visible; }

  html[data-font-navigation][data-font-state='loading'] .site-main,
  html[data-font-navigation][data-font-state='error'] .site-main { visibility: hidden; }

  html[data-font-state='loading']::after {
    content: '';
    position: fixed;
    top: calc(50% - 10px);
    left: calc(50% - 10px);
    width: 20px;
    height: 20px;
    border: 2px solid var(--line);
    border-top-color: var(--accent);
    border-radius: 50%;
    opacity: 0;
    animation: font-loading 900ms linear infinite, font-loading-show 0s 150ms forwards;
  }

  .font-load-retry {
    visibility: visible;
    position: fixed;
    inset: 0;
    margin: auto;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    color: var(--ink-soft);
    border: 1px solid var(--line);
    border-radius: 50%;
  }
  .font-load-retry svg { width: 22px; height: 22px; }
  @keyframes font-loading { to { transform: rotate(360deg); } }
  @keyframes font-loading-show { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    html[data-font-state='loading']::after { animation: none; opacity: 1; }
  }
</style>

<script>
  import { isPreparedNavigation } from '@/utils/navigation'

  let settledContent: Element | null = null
  let version = 0
  let slowTimer: number | undefined

  function showRetry() {
    document.documentElement.dataset.fontState = 'error'
    if (document.getElementById('font-load-retry')) return
    const button = document.createElement('button')
    button.id = 'font-load-retry'
    button.className = 'font-load-retry'
    button.type = 'button'
    button.title = '字体尚未加载成功，点击重试'
    button.setAttribute('aria-label', button.title)
    button.innerHTML = '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5M5.6 8a7 7 0 0 1 11.6-2L20 9M4 15l2.8 3A7 7 0 0 0 18.4 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>'
    button.addEventListener('click', () => location.reload())
    document.body.append(button)
  }

  async function revealWithFonts() {
    if (!document.fonts) return
    const content = document.getElementById('main')
    if (content === settledContent && document.documentElement.dataset.fontState === 'ready') return
    // Client navigation warms its fonts before the DOM swap. Paint immediately;
    // don't hide it again or walk the full document after page scripts execute.
    if (document.documentElement.hasAttribute('data-font-navigation')
      && document.documentElement.dataset.fontState === 'ready') {
      settledContent = content
      document.dispatchEvent(new Event('onpaper:fonts-ready'))
      document.dispatchEvent(new Event('onpaper:content-ready'))
      return
    }
    const current = ++version
    window.clearTimeout(slowTimer)
    document.getElementById('font-load-retry')?.remove()
    document.documentElement.dataset.fontState = 'loading'

    // Override the dependency's swap policy as well as our local font faces.
    // CSS block alone can still fall back after its short blocking period.
    const families = new Set<string>()
    for (const face of document.fonts) {
      face.display = 'block'
      families.add(face.family.replace(/['"]/g, ''))
    }

    // Load only unicode subsets used by this page, at their actual weights.
    const groups = new Map<string, Set<string>>()
    const styles = new WeakMap<Element, CSSStyleDeclaration>()
    const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT)
    while (walker.nextNode()) {
      const text = walker.currentNode.textContent ?? ''
      const parent = walker.currentNode.parentElement
      if (!parent || !text.trim() || parent.closest('script, style, noscript')) continue
      if (!parent.getClientRects().length) continue
      let style = styles.get(parent)
      if (!style) { style = getComputedStyle(parent); styles.set(parent, style) }
      if (![...families].some(family => style!.fontFamily.includes(family))) continue
      const font = style.fontStyle + ' ' + style.fontWeight + ' 16px ' + style.fontFamily
      let characters = groups.get(font)
      if (!characters) { characters = new Set(); groups.set(font, characters) }
      for (const character of text) characters.add(character)
    }

    slowTimer = window.setTimeout(() => { if (current === version) showRetry() }, 15000)
    try {
      await Promise.all([...groups].map(([font, characters]) => document.fonts.load(font, [...characters].join(''))))
      await document.fonts.ready
      if (current !== version) return
      window.clearTimeout(slowTimer)
      document.getElementById('font-load-retry')?.remove()
      // The mobile spacer must be measured with the final font metrics.
      document.dispatchEvent(new Event('onpaper:fonts-ready'))
      document.documentElement.dataset.fontState = 'ready'
      settledContent = content
      document.dispatchEvent(new Event('onpaper:content-ready'))
    }
    catch {
      if (current !== version) return
      window.clearTimeout(slowTimer)
      showRetry()
    }
  }

  document.addEventListener('astro:before-swap', (event) => {
    ++version
    window.clearTimeout(slowTimer)
    event.newDocument.documentElement.toggleAttribute('data-font-navigation',
      document.documentElement.dataset.fontState === 'ready'
        || document.documentElement.hasAttribute('data-font-navigation'))
    event.newDocument.documentElement.dataset.fontState = isPreparedNavigation(event.newDocument) ? 'ready' : 'loading'
  })
  document.addEventListener('astro:after-swap', () => {
    if (document.documentElement.dataset.fontState === 'ready') void revealWithFonts()
  })
  document.addEventListener('astro:page-load', revealWithFonts)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', revealWithFonts, { once: true })
  }
  else revealWithFonts()
</script>
