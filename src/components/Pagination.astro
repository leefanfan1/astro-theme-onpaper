---
import { t } from '@/i18n'
import T from '@/components/T.astro'

interface Props {
  currentPage: number
  totalPages: number
  /** The list's first page; later pages hang off it as `page/2/`. Defaults to
   *  the site root, which is where the article list lives. */
  base?: string
  label?: string
}

const { currentPage, totalPages, base: listBase, label = t('pagination.label') } = Astro.props
const base = (listBase ?? import.meta.env.BASE_URL).replace(/\/$/, '')

function pageHref(page: number) {
  return page === 1 ? `${base}/` : `${base}/page/${page}/`
}

const pages = Array.from({ length: totalPages }, (_, index) => index + 1)
---

{
  totalPages > 1 && (
    <nav class="pagination" aria-label={label}>
      <span class="pagination__side">
        {currentPage > 1
          ? <a href={pageHref(currentPage - 1)} rel="prev"><T k="pagination.previous" /></a>
          : <span class="pagination__disabled" aria-hidden="true"><T k="pagination.previous" /></span>}
      </span>

      <span class="pagination__pages">
        {pages.map(page => (
          page === currentPage
            ? <span class="pagination__current" aria-current="page">{page}</span>
            : <a href={pageHref(page)} aria-label={t('pagination.page', [page])}>{page}</a>
        ))}
      </span>

      <span class="pagination__side pagination__side--next">
        {currentPage < totalPages
          ? <a href={pageHref(currentPage + 1)} rel="next"><T k="pagination.next" /></a>
          : <span class="pagination__disabled" aria-hidden="true"><T k="pagination.next" /></span>}
      </span>
    </nav>
  )
}
