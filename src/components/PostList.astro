---
import type { Post } from '@/utils/posts'
import {
  formatDate,
  getPostHref,
  readingTime,
  stripMarkdown,
} from '@/utils/posts'

interface Props {
  posts: Post[]
}

const { posts } = Astro.props
---

<ol class="post-list">
  {posts.map((post, index) => {
    const minutes = readingTime(post.body ?? '')
    const excerpt = post.data.description
      || `${stripMarkdown(post.body ?? '').slice(0, 88)}…`

    return (
      <li
        class:list={['post-item', post.data.pin > 0 && 'post-item--pinned']}
        data-reveal
        style={`--reveal-delay:${Math.min(index, 5) * 55}ms`}
      >
        <article class="post-row">
          <h2 class="post-title">
            <a href={getPostHref(post)}>{post.data.title}</a>
            {post.data.pin > 0 && <span class="pin-badge">置顶</span>}
          </h2>

          <div class="post-meta">
            <time datetime={post.data.published.toISOString()}>{formatDate(post.data.published)}</time>
            <span class="post-meta__dot" aria-hidden="true"></span>
            <span>{minutes} 分钟</span>
          </div>

          {excerpt && <p class="post-desc">{excerpt}</p>}
        </article>
      </li>
    )
  })}
</ol>