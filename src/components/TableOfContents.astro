---
import type { MarkdownHeading } from 'astro'
import { siteConfig } from '@/config'

interface Props {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props
const items = headings.filter(heading => heading.depth >= 2 && heading.depth <= 3)
const groups: { heading: MarkdownHeading; children: MarkdownHeading[] }[] = []
for (const heading of items) {
  const parent = groups[groups.length - 1]
  if (heading.depth === 3 && parent?.heading.depth === 2) parent.children.push(heading)
  else groups.push({ heading, children: [] })
}
---

{
  items.length >= 2 && (
    <>
      {/* 窄屏/移动端：顶部折叠目录 */}
      <details class="toc toc--mobile" open={siteConfig.tocOpen}>
        <summary>
          <span class="toc__title">
            <svg class="toc__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 6h16M4 12h10M4 18h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            </svg>
            目录
          </span>
        </summary>
        <ol>
          {items.map(heading => (
            <li class={`toc-depth-${heading.depth}`}>
              <a href={`#${heading.slug}`} data-astro-history="replace" data-toc-link={heading.slug}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </details>

      {/* 同一份目录在原有页边距中展开，不改变正文布局。 */}
      <aside class="toc-desktop" aria-label="文章目录">
        <div class="toc-desktop__surface">
          <button type="button" class="toc-desktop__title" disabled aria-controls="article-toc" aria-label="展开文章目录">
            目录
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m6 4 4 4-4 4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <nav id="article-toc" class="toc-desktop__scroll" tabindex="0" aria-label="文章章节">
            <ol>
              {groups.map(({ heading, children }, index) => (
                <li>
                  <a href={`#${heading.slug}`} data-astro-history="replace" data-toc-link={heading.slug} data-toc-chapter={index}><span class="toc-desktop__text">{heading.text}</span></a>
                  {children.length > 0 && (
                    <div class="toc-desktop__children">
                      <ol>
                        {children.map(child => <li><a href={`#${child.slug}`} data-astro-history="replace" data-toc-link={child.slug}><span class="toc-desktop__text">{child.text}</span></a></li>)}
                      </ol>
                    </div>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        </div>
      </aside>
    </>
  )
}
