<button class="back-to-top" type="button" data-back-to-top aria-label="回到顶部">
  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M12 19V5M6.5 10.5 12 5l5.5 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <span>TOP</span>
</button>

<script>
  function updateBackToTop() {
    const button = document.querySelector('[data-back-to-top]')
    if (!button) return
    button.classList.toggle('is-visible', window.scrollY > 650)
  }

  document.addEventListener('click', (event) => {
    const target = event.target
    if (!(target instanceof Element) || !target.closest('[data-back-to-top]')) return
    window.scrollTo({ top: 0, behavior: 'smooth' })
  })

  document.addEventListener('astro:page-load', updateBackToTop)
  window.addEventListener('scroll', updateBackToTop, { passive: true })
  updateBackToTop()
</script>